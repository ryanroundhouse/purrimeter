  "narrative": {
    "northStar": "The garden under your fingertips",
    "overview": "The selected prototype B puts the existing pixel garden behind a small set of forest-green controls. Cream labels, gold recruitment and mint tactical information keep the familiar cats and combat state readable. Opaque surfaces provide separation from the animated field.\n\nThe selected A Garden sidebar extends this family to the main and in-game menus: existing animated cats and the title accompany a bounded forest action panel; a gold action gives entry or return to the garden priority. Menu surfaces share the gameplay palette without changing B\u2019s field controls.\n\nThis document captures the native Android implementation, including its app theme. It does not replace the desktop, browser or [website design system](../../../website/DESIGN.md). The selected direction is recorded in the [Android gameplay brief](../../../.impeccable/surface-briefs/android-gameplay.md); the [Android menu brief](../../../.impeccable/surface-briefs/android-menus.md) records the selected A direction. The name above describes the shared family rather than introducing a new identity.",
    "keyCharacteristics": [
      "Existing pixel cats and garden artwork remain the visual identity.",
      "Rounded, opaque controls float over an undistorted square field.",
      "Compact contextual panels preserve access to the wave controls.",
      "Menu sidebars prioritize one gold action and keep secondary navigation in a bounded scroll region.",
      "Density-scaled touch targets and Android text preferences govern readability."
    ],
    "rules": [
      {
        "name": "The Opaque Controls Rule",
        "body": "Keep actionable surfaces opaque so their contrast does not depend on the field beneath them.",
        "section": "colors"
      },
      {
        "name": "The Native Text Rule",
        "body": "Route custom-drawn labels and explicit native-control sizes through `GamePlatform` so Android text preferences reach both rendering paths.",
        "section": "typography"
      },
      {
        "name": "The Deliberate Resume Rule",
        "body": "Opening the menu pauses local play. Resume closes the menu and explicitly resumes; both close controls dismiss it while keeping the garden paused. Nested panels retain the existing app navigation and confirmation paths. Main menu saves and pauses after confirmation, and New garden retains its destructive-action confirmation. No visual menu state bypasses these behaviors.",
        "section": "components"
      }
    ],
    "dos": [
      "Do preserve the existing pixel cats, garden tiles and square board proportions.",
      "Do keep wave controls accessible while contextual panels or placement are active.",
      "Do use display-safe bounds, density scaling and native Android text scaling together.",
      "Do keep purchase validation and read-only restrictions authoritative in the game session.",
      "Do distinguish custom-drawn pill states from native-control theme states.",
      "Do preserve the gold primary menu action, visible pause close controls and scrollable secondary actions.",
      "Do show actual save progression and preserve explicit resume and destructive-action confirmation."
    ],
    "donts": [
      "Don't stretch the board to fit landscape dimensions.",
      "Don't add translucent control surfaces or floating shadows to this system; quiet menu actions sit on an opaque panel, and the pause scrim is only a backdrop.",
      "Don't replace the compact B gameplay panels with the desktop sidebar; A menu sidebars are a separate navigation surface.",
      "Don't apply this Android layout or typography contract to the website or other game platforms."
    ]
  }
}
